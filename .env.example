# Postgres — pooled connection for runtime, direct connection for migrations
DATABASE_URL="postgresql://user:password@localhost:5432/growthos?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/growthos?schema=public"

# GoHighLevel Marketplace app credentials (from the HighLevel developer portal)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI="http://localhost:3000/api/ghl/callback"
GHL_API_BASE_URL="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"
GHL_SCOPES="contacts.readonly opportunities.readonly calendars.readonly calendars/events.readonly invoices.readonly payments/orders.readonly payments/transactions.readonly locations.readonly users.readonly oauth.readonly oauth.write"
# Base64/PEM public key HighLevel publishes for verifying webhook signatures (Ed25519).
GHL_WEBHOOK_PUBLIC_KEY=

# 32-byte key (base64) for AES-256-GCM encryption of stored OAuth tokens.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="GrowthOS <noreply@example.com>"

# Shared secret checked on incoming requests to /api/cron/sync
CRON_SECRET=

# How many days of history the first sync for a new location pulls
SYNC_LOOKBACK_DAYS=180
